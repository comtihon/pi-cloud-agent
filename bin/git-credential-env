#!/bin/sh
# Generic git credential helper: answers from the environment, per host.
#
# git speaks the credential protocol on stdin ("protocol=https\nhost=…\n\n").
# For host `example.com` this helper looks for, in order:
#
#   GIT_TOKEN_EXAMPLE_COM      / GIT_USERNAME_EXAMPLE_COM
#   GIT_TOKEN                  / GIT_USERNAME          (host-independent)
#
# Nothing is written to disk and no service is hardcoded: whichever tool the
# carrier grants simply sets the matching variable, and a revoked tool's
# variable disappears with it. Username defaults to x-access-token, which is
# what token-based HTTPS auth wants on the common forges.
set -eu

host=''
while IFS= read -r line; do
    [ -z "$line" ] && break
    case "$line" in
        host=*) host=${line#host=} ;;
    esac
done

# example.com:8443 → EXAMPLE_COM_8443
key=$(printf '%s' "$host" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_' | sed 's/_*$//')

token=$(eval "printf '%s' \"\${GIT_TOKEN_${key}:-}\"")
[ -n "$token" ] || token=${GIT_TOKEN:-}
[ -n "$token" ] || exit 0

username=$(eval "printf '%s' \"\${GIT_USERNAME_${key}:-}\"")
[ -n "$username" ] || username=${GIT_USERNAME:-x-access-token}

printf 'username=%s\n' "$username"
printf 'password=%s\n' "$token"
